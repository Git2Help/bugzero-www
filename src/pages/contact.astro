---
import Layout from '../components/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
---

<Layout>
  <fragment slot="header">
    <Header />
  </fragment>

  <Section>
    <div class="text-center mb-10">
      <span class="text-sm font-normal" style="color:#696969;">Contact</span>
      <h2 class="mt-2 text-4xl sm:text-5xl font-semibold tracking-tight" style="font-family: &quot;Futura Sd&quot;, Futura, &quot;Trebuchet MS&quot;, sans-serif; color: rgb(0, 158, 224);">
        Contactez-nous
      </h2>
      <p class="mt-4 max-w-2xl mx-auto text-sm" style="color:#696969;">
        Une question ? Un problème ? Notre équipe est là pour vous répondre.
      </p>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <div>
        <div class="mt-6 space-y-4">
          <div class="flex items-center gap-3">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl" style="background-color: rgba(217, 224, 33, 0.3); color: rgb(0, 158, 224);">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="phone"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            </span>
            <div>
              <p class="text-sm font-medium" style="color: rgb(0, 158, 224);">06 78 56 54 30</p>
              <p class="text-xs" style="color:#696969;">Du lundi au vendredi, 9h-18h</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl" style="background-color: rgba(217, 224, 33, 0.3); color: rgb(0, 158, 224);">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="mail"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
            </span>
            <div>
              <p class="text-sm font-medium" style="color: rgb(0, 158, 224);">bonjour@bugzero.fr</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl" style="background-color: rgba(217, 224, 33, 0.3); color: rgb(0, 158, 224);">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="map-pin"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            </span>
            <div>
              <p class="text-sm font-medium" style="color: rgb(0, 158, 224);">9, Allée Lazare Sauvaigo</p>
              <p class="text-xs" style="color:#696969;">98000 Monaco</p>
            </div>
          </div>
        </div>
      </div>
      <div class="rounded-2xl border p-6 bg-white/85" style="border-color: rgba(0, 158, 224, 0.3);">
        <p class="text-sm font-semibold mb-4" style="font-family: &quot;Futura Sd&quot;, Futura, &quot;Trebuchet MS&quot;, sans-serif; color: rgb(0, 158, 224);">Envoyez-nous un message</p>
        <form id="contact-form" class="space-y-4">
          <input type="hidden" name="template" value="www">
          <input type="text" name="website" style="display:none" tabindex="-1" autocomplete="off">
          <div>
            <input type="text" name="name" id="name" placeholder="Nom" required class="w-full rounded-xl border px-4 py-2.5 text-sm bg-white" style="border-color: rgba(0, 158, 224, 0.3); color:#696969;">
          </div>
          <div>
            <input type="email" name="email" id="email" placeholder="Email" required class="w-full rounded-xl border px-4 py-2.5 text-sm bg-white" style="border-color: rgba(0, 158, 224, 0.3); color:#696969;">
          </div>
          <div>
            <input type="tel" name="phone" id="phone" placeholder="Téléphone (optionnel)" class="w-full rounded-xl border px-4 py-2.5 text-sm bg-white" style="border-color: rgba(0, 158, 224, 0.3); color:#696969;">
          </div>
          <div>
            <textarea name="message" id="message" placeholder="Votre message" rows="4" required class="w-full rounded-xl border px-4 py-2.5 text-sm bg-white" style="border-color: rgba(0, 158, 224, 0.3); color:#696969;"></textarea>
          </div>
          <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-xl px-6 py-3 text-sm font-medium text-white transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5 w-full" style="background-color: rgb(0, 158, 224);">
            Envoyer
          </button>
        </form>
        <div id="contact-success" style="display:none" class="mt-4 p-6 rounded-xl text-center" style="background-color: rgba(0, 158, 224, 0.1);">
          <p class="text-sm font-medium" style="color: rgb(0, 158, 224);">Merci pour votre message, il a bien été transmis.</p>
          <p class="text-xs mt-2" style="color:#696969;">Nous vous répondons dans l'heure.</p>
        </div>
        <div id="contact-error" style="display:none" class="mt-4 p-4 rounded-xl" style="background-color: rgba(255,0,0,0.1);">
          <p class="text-sm font-medium text-red-600" id="contact-error-msg"></p>
        </div>
        <script>
          const form = document.getElementById('contact-form');
          const successMsg = document.getElementById('contact-success');
          const errorMsg = document.getElementById('contact-error');
          const errorMsgText = document.getElementById('contact-error-msg');
          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(form);
            const data = Object.fromEntries(formData);
            const btn = form.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.textContent = 'Envoi en cours...';
            try {
              const res = await fetch('https://automate.bugzero.fr/webhook/contact-bugzero', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
              });
              const result = await res.json();
              if (result.success) {
                form.style.display = 'none';
                successMsg.style.display = 'block';
              } else {
                errorMsgText.textContent = result.message || 'Veuillez remplir tous les champs obligatoires.';
                errorMsg.style.display = 'block';
                btn.disabled = false;
                btn.textContent = 'Envoyer';
              }
            } catch (err) {
              errorMsgText.textContent = 'Une erreur est survenue. Veuillez réessayer ou nous appeler au 06 78 56 54 30.';
              errorMsg.style.display = 'block';
              btn.disabled = false;
              btn.textContent = 'Envoyer';
            }
          });
        </script>
      </div>
    </div>
  </Section>

  <fragment slot="footer">
    <Footer />
  </fragment>
</Layout>